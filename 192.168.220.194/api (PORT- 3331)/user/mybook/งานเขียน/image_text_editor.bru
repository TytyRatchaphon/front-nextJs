meta {
  name: /image_text_editor
  type: http
  seq: 3
}

post {
  url: {{path}}/user/image_text_editor
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: {{token}}
}

body:multipart-form {
  img: @file(/C:/Users/User/Pictures/Screenshots/Screenshot (2).png)
}

settings {
  encodeUrl: true
}
