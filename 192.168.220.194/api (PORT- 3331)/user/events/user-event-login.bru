meta {
  name: /user/event/login
  type: http
  seq: 6
}

get {
  url: {{path}}/user/event/login
  body: text
  auth: inherit
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  - ใช้เรียกข้อมูลของกิจกรรมล็อคอินของผู้ใช้
      
  - current_reward_day คือ วันที่ที่ผู้ใช้ต้องกดรับ
      
      - เช่น "current_reward_day": 1 คือ วันนี้ต้องกดรับของวันที่ 1
          
  - checked_in_today คือ วันนี้ผู้ใช้กดรับรางวัลไปแล้วหรือยัง
      
      - true กดรับไปแล้ว
          
      - falsee ยังไม่ได้กดรับ
}
