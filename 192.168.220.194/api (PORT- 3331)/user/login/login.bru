meta {
  name: /login
  type: http
  seq: 1
}

post {
  url: {{path}}/login
  body: json
  auth: inherit
}

body:json {
  { 
      "email" : "devbas2@gmail.com", 
      "password" : "123" 
  }
}

script:post-response {
  const response = res.getBody();
  
  // Test: Response status code is 200
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  // Test: Response has 'code' property equal to 200
  test("Response 'code' property equals 200", function () {
      expect(response).to.have.property('code');
      expect(response.code).to.eql(200);
  });
  
  // Test: Response 'status' property equals 'success'
  test("Response 'status' property equals 'success'", function () {
      expect(response).to.have.property('status');
      expect(response.status).to.eql('success');
  });
  
  // Test: Response contains 'data' property which is a non-empty string
  test("Response 'data' property is a non-empty string", function () {
      expect(response).to.have.property('data');
      expect(response.data).to.be.a('string').and.not.empty;
  });
  
  // Existing functionality: Save token and user ID to environment variables
  // if (response.data) {
  // //     pm.environment.set("user1_token", response.data);
  // }
}

settings {
  encodeUrl: true
}

example {
  name: /login
  
  request: {
    url: {{path}}/login
    method: POST
    mode: json
    body:json: {
      { 
          "email" : "devbas@gmail.com", 
          "password" : "123" 
      }
    }
  }
  
  response: {
    headers: {
      Access-Control-Allow-Origin: *
      Content-Type: application/json
