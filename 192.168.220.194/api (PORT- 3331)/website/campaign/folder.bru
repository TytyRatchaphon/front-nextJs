meta {
  name: campaign
  seq: 2
}

auth {
  mode: inherit
}

docs {
  GET
  
  - /getCampaign
      
      - ดึงข้อมูลแคมเปญทั้งหมด ที่ยังจัดอยู่
          
      - response data ได้ Array ของแคมเปญ
          
  - /getCampaignByID/:cp_id
      
      - รายละเอียดของแคมเปญ เอาไว้ใช้ตอนกดอ่าน
          
      - ยังไม่มีข้อมูลหนังสือในแคมเปญ
}
