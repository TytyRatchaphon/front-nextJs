meta {
  name: book
  seq: 1
}

auth {
  mode: inherit
}

docs {
  GET
  
  - /bookdetail/:bookID
      
      - ดึงข้อมูลรายละเอียดของหนังสือ โดยใช้ค่า bookID ในการค้นหา
          
      - response ได้ data
          
          - bookDetail : รายละเอียดหนังสือ
              
          - img : รูปภาพของหนังสือ
              
          - comment : จำนวนคอมเม้น
              
          - discount_full_book : โปรลดราคา ถ้ามี
              
  - /bookgroup/:bookID
      
      - เล่มของหนังสือ ของหนังสือจาก bookID (เช่น เล่ม 1 มีบท 1-100)
          
      - response ได้ data
          
          - group : เล่ม และ บทของเล่ม
              
          - read_continue : อ่านต่อจากมี่ user อ่านล่าสุด
              
  - /readep/:epID
      
      - นุ๊
}
