meta {
  name: Review Reply
  type: http
  seq: 2
}

post {
  url: {{path}}/bookdetail/reviews/replies/:comment_sub_book_id/report
  body: none
  auth: inherit
}

params:path {
  comment_sub_book_id: 485
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - รีพอร์ต คอมเมนท์ตอบกลับ ในรีวิว
      
  - Request
      
      - Param
          
          - comment_sub_book_id: Number = ไอดีของ คอมเมนท์ ในรีวิว
              
  - ผู้ใช้ไม่สามารถรีพอร์ตซ้ำของเดิมได้
      
  - ต้องล็อคอินก่อน
}
