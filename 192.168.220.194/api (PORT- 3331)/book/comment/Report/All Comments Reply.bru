meta {
  name: All Comments Reply
  type: http
  seq: 4
}

post {
  url: {{path}}/bookdetail/comments/replies/:comment_sub_ep_id/report
  body: none
  auth: inherit
}

params:path {
  comment_sub_ep_id: 885
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - รีพอร์ต คอมเมนท์ตอบกลับ ในคอมเมนท์ทั้งหมด
      
  - Request
      
      - Param
          
          - comment_sub_ep_id: Number = ไอดีของคอมเมนท์ตอบกลับ
              
  - ผู้ใช้ไม่สามารถรีพอร์ตซ้ำของเดิมได้
      
  - ต้องล็อคอินก่อน
}
