meta {
  name: All Comments
  type: http
  seq: 3
}

post {
  url: {{path}}/bookdetail/comments/:comment_ep_id/report
  body: none
  auth: inherit
}

params:path {
  comment_ep_id: 485
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - รีพอร์ต คอมเมนท์ ในคอมเมนท์ทั้งหมด
      
  - Request
      
      - Param
          
          - comment_ep_id: Number = ไอดีของคอมเมนท์
              
  - ผู้ใช้ไม่สามารถรีพอร์ตซ้ำของเดิมได้
      
  - ต้องล็อคอินก่อน
}
