meta {
  name: Episode Comment
  type: http
  seq: 4
}

post {
  url: {{path}}/readep/:ep_id/comments
  body: json
  auth: inherit
}

params:path {
  ep_id: 100000030
}

headers {
  Authorization: {{token}}
}

body:json {
  {
      "comment": "test"
  }
}

settings {
  encodeUrl: true
}

docs {
  - เพิ่มคอมเมนท์ของคอมเมนท์ตอนอ่าน บท นิยาย
      
  - Request
      
      - Param
          
          - ep_id: Number = ไอดีบท
              
      - Body
          
          - comment: Text = ข้อความคอมเมนท์
              
  - ต้องล็อคอินก่อน
}
