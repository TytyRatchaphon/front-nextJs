meta {
  name: Review
  type: http
  seq: 1
}

post {
  url: {{path}}/bookdetail/:book_id/reviews
  body: json
  auth: inherit
}

params:path {
  book_id: 53
}

headers {
  Authorization: {{user1_token}}
}

body:json {
  {
      "comment": "Test notification 2",
      "star": 4
  }
}

settings {
  encodeUrl: true
}

docs {
  - เพิ่มรีวิวของหนังสือนั้น
      
  - Request
      
      - Param
          
          - book_id: Number = ไอดีของหนังสือ
              
      - Body
          
          - comment: Text = ข้อความคอมเมนท์
              
          - star: Number = ดาวที่ให้ (1 ถึง 5)
              
  - ต้องล็อคอินก่อน
}
