meta {
  name: All Comments Reply
  type: http
  seq: 3
}

post {
  url: {{path}}/bookdetail/comments/:comment_ep_id/replies
  body: json
  auth: inherit
}

params:path {
  comment_ep_id: 27665
}

headers {
  Authorization: {{token}}
}

body:json {
  {
      "comment": "test"
  }
}

settings {
  encodeUrl: true
}

docs {
  - เพิ่มคอมเมนท์ตอบกลับ ใน คอมเมนท์ทั้งหมด
      
  - Request
      
      - Param
          
          - comment_ep_id: Number = ไอดีของ comment ในคอมเมนท์ทั้งหมด
              
      - Body
          
          - comment: Text = ข้อความคอมเมนท์
              
  - ต้องล็อคอินก่อน
}
