meta {
  name: Review Reply
  type: http
  seq: 2
}

delete {
  url: {{path}}/bookdetail/reviews/replies/:comment_sub_book_id
  body: none
  auth: inherit
}

params:path {
  comment_sub_book_id: 269
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - Request
      
      - Param
          
          - comment_sub_book_id: Number = ไอดีคอมเมนท์ตอบกลับรีวิว
              
  - ต้องล็อคอินก่อน
      
  - ผู้ใช้ที่สร้างคอมเมนท์นี้เท่านั้นจึงจะสามารถลบเองได้
}
