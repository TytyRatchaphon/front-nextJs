meta {
  name: Episode Comment
  type: http
  seq: 5
}

delete {
  url: {{path}}/readep/comments/:comment_ep_id
  body: none
  auth: inherit
}

params:path {
  comment_ep_id: 27664
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - ลบ คอมเมนท์ ของคอมเมนท์ในหน้าอ่านนิยาย
      
  - Request
      
      - Param
          
          - comment_ep_id: Number = ไอดีคอมเมนท์ ใน คอมเมนท์ทั้งหมด
              
  - ต้องล็อคอินก่อน
      
  - ผู้ใช้ที่สร้างคอมเมนท์นี้เท่านั้นจึงจะสามารถลบเองได้
}
