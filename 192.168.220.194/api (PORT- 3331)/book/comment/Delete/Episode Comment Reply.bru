meta {
  name: Episode Comment Reply
  type: http
  seq: 6
}

delete {
  url: {{path}}/readep/comments/replies/:comment_sub_ep_id
  body: none
  auth: inherit
}

params:path {
  comment_sub_ep_id: 1121
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - ลบ คอมเมนท์ตอบกลับ ของคอมเมนท์ในหน้าอ่านนิยาย
      
  - Request
      
      - Param
          
          - comment_sub_ep_id: Number = ไอดีคอมเมนท์ตอบกลับ ของคอมเมนท์ในหน้าอ่านนิยาย
              
  - ต้องล็อคอินก่อน
      
  - ผู้ใช้ที่สร้างคอมเมนท์นี้เท่านั้นจึงจะสามารถลบเองได้
}
