meta {
  name: All Comment Reply
  type: http
  seq: 4
}

delete {
  url: {{path}}/bookdetail/comments/replies/:comment_ep_id
  body: none
  auth: inherit
}

params:path {
  comment_ep_id: 27664
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - ลบ คอมเมนท์ตอบกลับ ของคอมเมนท์ทั้งหมด
      
  - Request
      
      - Param
          
          - comment_ep_id: Number = ไอดีคอมเมนท์ ใน คอมเมนท์ทั้งหมด
              
  - ต้องล็อคอินก่อน
      
  - ผู้ใช้ที่สร้างคอมเมนท์นี้เท่านั้นจึงจะสามารถลบเองได้
}
