meta {
  name: Review
  type: http
  seq: 1
}

delete {
  url: {{path}}/bookdetail/reviews/:comment_book_id
  body: none
  auth: inherit
}

params:path {
  comment_book_id: 2312
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - Request
      
      - Param
          
          - comment_book_id: Number = ไอดีรีวิว
              
  - ต้องล็อคอินก่อน
      
  - ผู้ใช้ที่สร้างคอมเมนท์นี้เท่านั้นจึงจะสามารถลบเองได้
}
