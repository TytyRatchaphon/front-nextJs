meta {
  name: Episode Comments
  type: http
  seq: 3
}

get {
  url: {{path}}/readep/:ep_id/comments
  body: none
  auth: inherit
}

params:path {
  ep_id: 3453
}

settings {
  encodeUrl: true
}

docs {
  - ใช้ดึงข้อมูลคอมเมนท์ใน **บท** ของหนังสือ
      
  - Request
      
      - Param
          
          - ep_id ไอดีของบทนั้น
              
      - Query
          
          - limit
              
          - page
              
  - Response
      
      - pagination
          
      - comment_data ข้อมูลของ comment
          
          - user
              
          - comment_sub_data ข้อมูลของ comment ตอบกลับ
              
              - user
}
