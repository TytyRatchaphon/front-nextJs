meta {
  name: Reviews
  type: http
  seq: 1
}

get {
  url: {{path}}/bookdetail/:book_id/reviews?limit=20&page=10
  body: none
  auth: inherit
}

params:query {
  limit: 20
  page: 10
}

params:path {
  book_id: 53
}

headers {
  Authorization: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  - ดึงข้อมูลคอมเมน **รีวิว** ของหนังสือนั้น
      
  - Request
      
      - Param เป็น book_id ไอดีของหนังสือ
          
      - Query มี limit (Default = 20) และ page (Default = 1)
          
  - Response
      
      - pagination
          
      - comment_data ข้อมูลของ comment
          
          - user
              
          - comment_sub_data ข้อมูลของ comment ตอบกลับ
              
              - user
}
