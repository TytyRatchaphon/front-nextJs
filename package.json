{
  "name": "enjoybook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:e2e": "next dev --turbopack --hostname 127.0.0.1",
    "build": "bun run lint && next build --turbopack",
    "start": "next start ",
    "deploy": "bun run build",
    "deploy:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target test",
    "deploy:test:built": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target test -SkipBuild",
    "deploy:test:init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target test -ResetProcess",
    "deploy:test:init:built": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target test -SkipBuild -ResetProcess",
    "deploy:test:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target test -Rollback",
    "deploy:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target production",
    "deploy:prod:built": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target production -SkipBuild",
    "deploy:prod:init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target production -ResetProcess",
    "deploy:prod:init:built": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target production -SkipBuild -ResetProcess",
    "deploy:prod:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-aapanel.ps1 -Target production -Rollback",
    "lint": "node scripts/check-mojibake.mjs && eslint",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "fix:mojibake": "node scripts/fix-mojibake.mjs --write",
    "audit:sitemap": "node scripts/audit-sitemap-metadata.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/react-components": "^10.1.2",
    "@kazion/react-facebook-login": "^1.1.0",
    "@line/liff": "^2.27.2",
    "@next/third-parties": "^16.1.4",
    "@react-oauth/google": "^0.12.2",
    "@tailwindcss/cli": "^4.1.14",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-query-devtools": "^5.90.2",
    "antd": "^5.27.6",
    "antd-img-crop": "^4.27.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "gifuct-js": "^2.1.2",
    "hls.js": "^1.6.16",
    "html-react-parser": "^5.2.7",
    "install": "^0.13.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.35",
    "lucide-react": "^0.555.0",
    "next": "16.1.0",
    "postcss": "^8.5.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-share": "^5.2.2",
    "recharts": "^3.3.0",
    "socket.io-client": "^4.8.1",
    "swiper": "^12.0.2",
    "tailwind-scrollbar-hide": "^4.0.0",
    "video.js": "^8.23.8",
    "@types/video.js": "^7.3.58",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "4.0.18",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5",
    "vitest": "4.0.18"
  }
}
